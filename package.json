{
  "name": "novyra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/write-version.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:language-autonyms": "node scripts/check-language-autonyms.mjs",
    "test:regional-preferences": "node --experimental-strip-types scripts/check-regional-preferences.mjs",
    "test:auth-translations": "node scripts/check-auth-translations.mjs",
    "test:regional-profile-schema": "node scripts/check-regional-profile-schema.mjs && node --input-type=module --check < workers/api/index.js && node --check workers/api/business-sync.js",
    "test:business-preview": "node scripts/check-business-preview.mjs",
    "test:auth-login": "node --test shared/email.test.mjs workers/api/tests/auth-login.test.mjs workers/api/tests/auth-password.test.mjs workers/api/tests/auth-forgot.test.mjs workers/api/tests/auth-reset.test.mjs",
    "test:auth-client": "node --experimental-strip-types scripts/check-auth-client.mjs",
    "test:e2e": "playwright test",
    "serve:e2e": "node scripts/serve-static.mjs",
    "test:money": "node --experimental-strip-types scripts/check-money.mjs",
    "test:money-usage": "node scripts/check-money-usage.mjs",
    "test:email-normalization": "node --test shared/email.test.mjs",
    "test:personal-finance": "node --experimental-strip-types --test app/lib/personal-finance.test.mjs",
    "test:finance-sync": "node --experimental-strip-types --test app/lib/finance-sync.test.mjs app/lib/finance-collections-sync.test.mjs"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.8",
    "react-dom": "19.1.8",
    "lucide-react": "^0.468.0",
    "@hookform/resolvers": "^5.2.2",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.5",
    "@simplewebauthn/server": "^13.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.33",
    "autoprefixer": "^10.4.21",
    "@playwright/test": "^1.55.0"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
